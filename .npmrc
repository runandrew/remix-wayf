# eslint-plugin-react@7.37.5 and eslint-plugin-jsx-a11y@6.10.2 are the newest
# releases, and both peer ranges stop at ESLint 9. Recommended jsx-a11y runs
# on ESLint 10. Recommended react rules run when settings.react.version is set.
# No release has widened either peer range.
legacy-peer-deps=true
