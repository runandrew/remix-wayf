{
  "framework": null,
  "buildCommand": "mkdir -p public && printf 'Redirect-only. WAYF runs on Cloudflare Workers.\\n' > public/index.html",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "https://wayf.quietlymadesoftware.com/",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "destination": "https://wayf.quietlymadesoftware.com/:path*",
      "statusCode": 308
    }
  ]
}
