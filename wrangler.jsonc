{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayf",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "wayf.quietlymadesoftware.com",
      "custom_domain": true
    },
    {
      "pattern": "wayf.grainlabs.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    // POST /create must reach the Worker. A static `/` HTML asset 405s
    // document form posts that stay on `/`.
    "run_worker_first": ["/", "/create"]
  }
  // DATABASE_URL is a Worker secret. Do not put it in `vars`.
  //   npx wrangler secret put DATABASE_URL
  // Locally, copy .dev.vars.example to .dev.vars.
  // Public host is wayf.quietlymadesoftware.com. grainlabs.co stays attached.
}
